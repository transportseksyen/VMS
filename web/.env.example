VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Never put SUPABASE_SERVICE_ROLE_KEY or an email provider secret in VITE_* variables.
# This project expects public application intake and privileged email/user administration
# to run through Supabase Edge Functions with server-side secrets.